# Pearss 环境配置模板 —— 复制为 .env 后按需填写。
#
#   cp .env.example .env && chmod 600 .env
#
# `.env` 是 gitignored 的，密钥只应存在这里或部署平台的 Secret 里（AGENTS.md）。
# `just run` / `just serve` / `just backup` 会 source 它；应用本身只读 os.environ，
# 这样配置只有一个可见入口，而不是某个 import 悄悄把文件拉进来。
#
# 生成随机密钥：
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 未设置的变量一律走源码里的默认值；下面每一项都标注了默认值与影响。


# ===========================================================================
# 必需 —— 不配则服务 fail-closed
# ===========================================================================

# Core API（/v1）的 bearer token。读写与 ingest 皆可。
# 未设置时所有 Core API 请求被拒，启动日志会警告。
PEARSS_API_TOKEN=

# 可选：只读 token。持它写操作返回 403（AGENTS.md 的 scope 分离）。
PEARSS_API_READ_TOKEN=

# 可选：A3 主动接入专用 token（ADR 0022）。只授予 ingest scope —— 只能向
# agent 型源推送内容，不能删源、改配置或读已读状态。给外部 agent 用它，
# 而不是 PEARSS_API_TOKEN：泄漏时的损失面仅限「能往 agent 源塞内容」。
PEARSS_INGEST_TOKEN=

# MCP 工具面的边界 token。独立于 PEARSS_API_TOKEN：撤销一台笔记本的 MCP
# 客户端不应把其它调用方一起登出。
PEARSS_MCP_TOKEN=


# ===========================================================================
# 监听
# ===========================================================================

# 绑定地址。默认 127.0.0.1 —— 单用户服务不应在无显式决定的情况下触网。
#   隧道部署（ADR 0016）：保持 127.0.0.1，由隧道代理对外。
#   直连局域网/Tailscale：改成对应地址，例如 100.64.0.1。
PEARSS_BIND_HOST=127.0.0.1
PEARSS_PORT=8000

# 远程访问 MCP 时必须放宽 SDK 的 DNS-rebinding 保护，逗号分隔。
# loopback 始终被接受，所以加主机名不会把自己锁在门外。
# 端口必须匹配，用 host:* 通配："pearss.example.com:*"。
# PEARSS_MCP_ALLOWED_HOSTS=pearss.example.com:*


# ===========================================================================
# 数据存储
# ===========================================================================

# SQLite 路径。默认 sqlite+pysqlite:///data/pearss.db（相对项目目录）。
# PEARSS_DATABASE_URL=sqlite+pysqlite:///data/pearss.db

# 正文的 content-addressed 存储目录。默认项目内的 data/bodies（见 filestore）。
# PEARSS_STORAGE_DIR=


# ===========================================================================
# Reader API —— NetNewsWire 用 FreshRSS 账号类型连接
# ===========================================================================

# 凭据只从环境读；库内只存 scrypt 哈希，明文永不落库（ADR 0005）。
# 不设 PEARSS_READER_PASSWORD 时 Reader API 登录整体禁用。
PEARSS_READER_USERNAME=reader
PEARSS_READER_PASSWORD=

# 注意：auth token 由 HMAC(username + 密码哈希) 派生，改密码会使所有已登录
# 客户端的 token 失效（ADR 0005/0016）。NNW 无"改密码"入口，只能删账号重加。


# ===========================================================================
# 公网暴露（隧道部署，ADR 0016）
# ===========================================================================

# 公网只暴露已鉴权的 Reader API；公开 RSS 输出已移除。
# 0 = 关闭 Swagger/redoc/openapi.json。Tailscale Funnel 按主机名整源暴露、
# 无法按路径路由，此时必须设 0，否则完整 API schema 会披露给公网。
PEARSS_DOCS_ENABLED=1

# 401/403 失败预算与阻断时长（按客户端地址计数，经 XFF 取真实地址）。
# 0 = 关闭限速。
PEARSS_AUTH_RATELIMIT_MAX=50           # 窗口内失败次数上限
PEARSS_AUTH_RATELIMIT_WINDOW_SECONDS=300
PEARSS_AUTH_RATELIMIT_BLOCK_SECONDS=900

# 请求体上限，超限 413。0 = 不限。
PEARSS_MAX_BODY_BYTES=1048576

# 审计行保留天数，0 = 永久。审计是取证窗口（默认 30 天）。
PEARSS_AUDIT_RETENTION_DAYS=30

# 1 = 允许采集私网地址的源。默认 0：SSRF 守卫拒绝解析到私网的 fetch（ADR 0016）。
# 仅在确需采集内网源时打开。
PEARSS_ALLOW_PRIVATE_FETCH=0


# ===========================================================================
# 调度与处理
# ===========================================================================

# 0 = 只跑 API 不跑调度（不采集、不做审计清理、不跑 enrichment）。
PEARSS_SCHEDULER_ENABLED=1

# 轮询间隔（秒）。到期与否每轮从 schedule_policy + 历史推导，不落库（ADR 0009）。
PEARSS_TICK_SECONDS=60

# 一轮 tick 内并发采集的源数。
PEARSS_TICK_CONCURRENCY=3

# enrichment worker 的并发处理数。
PEARSS_ENRICHMENT_CONCURRENCY=3

# 日志级别：DEBUG / INFO / WARNING / ERROR。
PEARSS_LOG_LEVEL=INFO


# ===========================================================================
# 翻译处理器（按源启用 pipeline_chain 后生效）
# ===========================================================================

# 任何 OpenAI-compatible chat completions 端点。填到 /v1 为止，
# /chat/completions 由代码拼接（不要自带）。
# PEARSS_TRANSLATE_BASE_URL=https://api.openai.com/v1
PEARSS_TRANSLATE_BASE_URL=
PEARSS_TRANSLATE_API_KEY=

# 主模型。与 PEARSS_TRANSLATE_MODELS 二选一，后者优先。
# PEARSS_TRANSLATE_MODEL=gpt-4o-mini

# 可选：逗号分隔的备选链，按顺序降级（429/5xx/不可达时切下一个）。
# PEARSS_TRANSLATE_MODELS=gpt-4o-mini,gpt-4o,deepseek-chat


# ===========================================================================
# CookieCloud（X 与知乎/知识星球共用的凭据分发）
# ===========================================================================

# 三者齐备才启用；缺一则相关采集器读不到凭据并报 auth。
# 按 domain 过滤，因此一个 CookieCloud 部署可服务多个采集器。
# PEARSS_COOKIECLOUD_URL=
# PEARSS_COOKIECLOUD_UUID=
# PEARSS_COOKIECLOUD_TOKEN=
# 凭据缓存秒数，避免每次采集都打 CookieCloud。
PEARSS_COOKIECLOUD_CACHE_SECONDS=300


# ===========================================================================
# 采集器凭据（按需启用；未配置的采集器报 auth 而非崩溃）
# ===========================================================================

# --- X / Twitter（也可经 CookieCloud 取，静态值优先） ---
# PEARSS_X_AUTH_TOKEN=
# PEARSS_X_CT0=
# 可选：X 会轮换 queryId；环境值用于在代码内默认值失效时覆盖。
# PEARSS_X_QUERY_ID=
# 每页推文数，1–40，默认 20。
PEARSS_X_COUNT=20
# 首次采集的页数预算（默认 3）：它决定历史下沿——第一轮走到哪，之后的
# 每轮都只在其上方补新，不再往更深处爬。
# PEARSS_X_FIRST_PAGES=
# PEARSS_X_USER_AGENT=

# --- 知乎（可经 CookieCloud 取） ---
# PEARSS_ZHIHU_COOKIES=
# PEARSS_ZHIHU_USER_AGENT=

# --- 知识星球（cookie 与 access token 二选一即可） ---
# PEARSS_ZSXQ_COOKIE=
# PEARSS_ZSXQ_ACCESS_TOKEN=
# PEARSS_ZSXQ_USER_AGENT=


# ===========================================================================
# 备份与恢复（just backup / just restore）
# ===========================================================================

# 备份归档目录，默认项目内 backups/（gitignored）。
# 部署为 systemd timer 时建议指向项目外，避免随代码目录一起被清理。
PEARSS_BACKUP_DIR=backups

# 仅 just restore 使用，通常由食谱从命令行参数设置，不必写进 .env。
# PEARSS_RESTORE_ARCHIVE=
# PEARSS_RESTORE_TARGET=


# ===========================================================================
# 内部/CLI 专用 —— 通常不需要手工设置
# ===========================================================================

# enrichment 回填 CLI 的入参（just enrichment-backfill 会设置）。
# PEARSS_BACKFILL_SOURCE_ID=
# PEARSS_BACKFILL_LIMIT=

# 沙箱子进程内部标记，由 env allowlist 自动注入，不要在 .env 里设置。
# PEARSS_SANDBOXED=1
