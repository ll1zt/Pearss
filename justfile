# Pearss command entry point.
#
# Section 10.3: every command used by humans, agents and CI is declared here.
# README, AGENTS.md and CI reference only these names. If a step cannot be
# expressed as a recipe, it does not belong in the workflow.

set shell := ["bash", "-uc"]

# Surface the environment early: these fail with clear messages instead of
# letting a later step die on a missing binary.
python := "uv run python"
project := "pearss"

# Show the available recipes.
default:
    @just --list

# Print the toolchain the environment resolved to.
shell:
    @echo "python: $(uv run python -V 2>&1)"
    @echo "uv:     $(uv --version)"
    @echo "just:   $(just --version)"
    @echo "ruff:   $(uv run ruff --version)"
    @echo "mypy:   $(uv run mypy --version)"

# Install or update Python dependencies from uv.lock.
sync:
    uv sync

# ---------------------------------------------------------------------------
# Quality gates
# ---------------------------------------------------------------------------

# Format, lint, type check and enforce the layer contract.
lint: 
    uv run ruff format --check .
    uv run ruff check .
    uv run mypy
    uv run lint-imports

# Apply fixes for what can be fixed automatically.
fix:
    uv run ruff format .
    uv run ruff check --fix .

# pytest exits 5 for "no tests collected". The skeleton has an empty suite,
# and a gate that fails for having nothing to check is a gate people learn to
# ignore, so 5 is treated as success. Real test failures still fail.
_test marker:
    #!/usr/bin/env bash
    set -uo pipefail
    uv run pytest -m "{{marker}}" -q
    status=$?
    if [ "$status" -eq 5 ]; then
        echo "no tests collected for marker '{{marker}}' — treating as pass"
        exit 0
    fi
    exit "$status"

# Unit and fixture tests (offline and deterministic).
test:
    just _test unit\ or\ fixture

# Tests that touch SQLite or temporary local services, but never the network.
test-integration:
    just _test integration

# OpenAPI diff and MCP tool snapshots. Stubs until the API surface exists.
contract:
    @echo "contract: OpenAPI diff not yet wired (no API surface in the skeleton)"
    @echo "contract: MCP tool snapshot not yet wired (no MCP tools yet)"
    @just _test contract

# Full Compose end-to-end run. Requires Docker.
e2e:
    @echo "e2e: not yet wired — needs compose.yaml and the P1 service images"
    @just _test e2e

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Apply migrations up to head.
migrate:
    uv run alembic upgrade head

# Verify every migration upgrades and downgrades cleanly.
migrate-check:
    @echo "migrate-check: verifying upgrade head, then full downgrade, then up again"
    uv run alembic upgrade head
    uv run alembic downgrade base
    uv run alembic upgrade head

# Create a new migration with an autogenerated revision id.
revision message:
    uv run alembic revision --autogenerate -m "{{message}}"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Start the API server. Not yet wired: no ASGI app exists in the skeleton.
run:
    @echo "run: not yet wired — the FastAPI app arrives with the core API work"

# ---------------------------------------------------------------------------
# Aggregate
# ---------------------------------------------------------------------------

# Everything CI runs, in the order architecture section 7.6 prescribes.
ci: lint test test-integration migrate-check contract

# The exact command CI executes, including the Nix environment entry point.
ci-nix:
    nix flake check
    nix develop --command just ci
