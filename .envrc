#!/usr/bin/env bash

# devenv's shells set env vars that must be re-exported on every prompt, which
# plain `use flake` does not do. nix-direnv additionally caches the shell so
# re-entering a directory is instant instead of re-evaluating the flake.
if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

# Watch the files that define the environment: flake inputs and the devenv
# module that flake.nix feeds into devenv.lib.mkShell.
watch_file flake.nix
watch_file flake.lock
watch_file devenv.nix

# --no-pure-eval is required: devenv reads PWD to locate the project root.
if ! use flake . --no-pure-eval; then
  echo "devenv could not be built. The Pearss environment was not loaded." >&2
  echo "Fix flake.nix or devenv.nix and hit enter to retry." >&2
fi
