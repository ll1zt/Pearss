#!/usr/bin/env bash

# nix-direnv caches the dev shell, so re-entering the directory is instant
# instead of re-evaluating the flake. It also re-exports the shell's
# environment on every prompt, which plain `use flake` does not do.
if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

# Watch the files that define the environment. flake.lock changes on every
# `nix flake update`, so it belongs here too.
watch_file flake.nix
watch_file flake.lock

# Plain `use flake` — no --impure. The dev shell is built from pkgs.mkShell,
# which evaluates purely; devenv was removed because it resolved its project
# root from $PWD at evaluation time, forcing --impure and breaking the
# `nix develop --command just ci` entry point that section 10.4 specifies.
# See ADR 0002.
use flake .
